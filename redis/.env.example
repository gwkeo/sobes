# HTTP
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=text
SHUTDOWN_TIMEOUT=10s
# Read-only cache inspection, manual invalidation and /debug/stats.
# Do not expose in production.
ENABLE_DEBUG=true

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT=1s
REDIS_READ_TIMEOUT=1s
REDIS_WRITE_TIMEOUT=1s
# true: fail fast if Redis is unavailable at startup.
REDIS_REQUIRED=false

# Cache
CACHE_PREFIX=shop
CACHE_KEY_VERSION=v1
CACHE_PRODUCT_FRESH_TTL=20s
CACHE_PRODUCT_STALE_TTL=3m
CACHE_LIST_FRESH_TTL=15s
CACHE_LIST_STALE_TTL=2m
CACHE_NEGATIVE_TTL=20s
CACHE_L1_TTL=2s
CACHE_L1_MAX_ENTRIES=10000
CACHE_LOCK_TTL=3s
CACHE_LOCK_WAIT=300ms
CACHE_OP_TIMEOUT=300ms
CACHE_LOAD_TIMEOUT=5s
CACHE_JITTER=0.10

# Rate limit: sliding window per API key / IP.
RATE_LIMIT=60
RATE_WINDOW=1m

# Idempotency
IDEMPOTENCY_TTL=24h
IDEMPOTENCY_LOCK_TTL=30s

# Simulated "database" latency. Set 0 to make tests/benchmarks faster.
STORE_LATENCY=80ms
